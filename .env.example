PORT=3000
NODE_ENV=development

# Use SQLite localmente. DATABASE_URL, quando definida, ativa PostgreSQL.
RAIZES_DB_PATH=./data/raizes.sqlite
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/raizes

# Gere um segredo aleatório de ao menos 32 bytes para cookies de sessão.
RAIZES_SESSION_SECRET=
RAIZES_API_ADMIN_TOKEN=

# Semeadura opcional somente em desenvolvimento; senhas com ao menos 12 caracteres.
RAIZES_DEV_ADMIN_EMAIL=
RAIZES_DEV_ADMIN_PASSWORD=
RAIZES_DEV_STORE_EMAIL=
RAIZES_DEV_STORE_PASSWORD=

# Origens extras permitidas para frontend hospedado em domínio separado (separadas por vírgula).
RAIZES_CORS_ORIGINS=
